                    QualityInspection."serial No" := Rec."Serial No";
                    QualityInspection."Inspection Date" := Today;
                    QualityInspection."Quality Result" :=
                        QualityInspection."Quality Result"::Pending;

                    QualityInspection.Insert(true);
                    Page.Run(Page::"Quality Inspection Card", QualityInspection);
                end;
